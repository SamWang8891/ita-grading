ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# CORS：允許的前端來源，逗號分隔。跨網域部署（如 Cloudflare Pages）必填。
# 範例：ALLOWED_ORIGINS=https://myapp.pages.dev,https://myapp.example.com
ALLOWED_ORIGINS=

# Session cookie 行為
# 同源部署：COOKIE_SECURE=0、COOKIE_SAMESITE=lax 即可
# 跨網域部署（前後端不同網域）：必須 COOKIE_SECURE=1 + COOKIE_SAMESITE=none
#   且後端一定要走 https，否則瀏覽器會丟棄 cookie
COOKIE_SECURE=0
COOKIE_SAMESITE=lax
